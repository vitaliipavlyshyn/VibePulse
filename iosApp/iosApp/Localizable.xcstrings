  "strings" : {
    "%d" : {
      "comment" : "A label displaying the user's current cadence in steps per minute.",
      "isCommentAutoGenerated" : true
    },
    "%d BPM" : {
      "comment" : "A badge displaying the tempo of the currently playing track in beats per minute. The argument is the tempo of the track.",
      "isCommentAutoGenerated" : true
    },
    "%d steps · %@" : {
      "comment" : "A description of the activity, including the number of steps and active duration.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$d steps · %2$@"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A label displaying the current cadence of the user's steps per minute.",
      "isCommentAutoGenerated" : true
    },
    "%lld min" : {
      "comment" : "Value for the subtitle of a KPI",
      "isCommentAutoGenerated" : true
    },
    "%lld°C · %@" : {
      "comment" : "A subheading that displays the current temperature and weather condition. The first argument is the temperature in degrees Celsius. The second argument is the weather condition.",
